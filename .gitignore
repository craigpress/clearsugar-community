# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
tmp_*.json
tmp_audit/

# Private iOS working copy (the community iOS app lives in ios/ and IS tracked;
# its own ios/.gitignore excludes generated projects and Server.xcconfig)
clearsugar-ios/

# ONNX models — inference runs on the ML prediction server, not in browser
public/models/

# Local data directory (self-hosted blob replacement)
.data/

# docker compose local overrides
docker/docker-compose.override.yml

# Python
__pycache__/
*.pyc

# ML retrain runtime log
ml-retrain.log

# esbuild scratch from advisor replay/golden harnesses
tmp/
/c/
scripts/.golden/

# Advisor analysis outputs (regenerable via scripts; contain raw BG data)
docs/phase0-*.json
docs/phase1-*.json
docs/shadow-replay-7d.json

# Local agent/editor config
.claude/
