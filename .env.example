# ClearSugar Community — environment configuration
#
# Copy this file to .env and fill in real values, or run `npm run setup` to
# generate it interactively (recommended). Never commit .env.

# ─── Required ────────────────────────────────────────────────────────────────

# Base URL of your Nightscout instance (no trailing slash).
NIGHTSCOUT_URL=http://localhost:1337

# Nightscout API secret (the same secret your Nightscout site uses).
NIGHTSCOUT_API_SECRET=changeme

# NextAuth session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=changeme

# Machine-client API key for timers/cron and companion apps (X-API-Key header).
# Generate with: openssl rand -base64 32
CLEARSUGAR_API_KEY=changeme

# Local data directory for JSON storage (auth, profile, alert state, reports).
# Default: ./.data in dev, /opt/clearsugar/data in production.
CLEARSUGAR_DATA_DIR=./.data

# ─── AI insights (optional) ──────────────────────────────────────────────────

# One of: anthropic | claude-cli | codex-cli | ollama | openai-compatible | none
LLM_PROVIDER=none

# anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ollama provider (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# openai-compatible provider (any OpenAI-compatible chat completions server)
OPENAI_COMPAT_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# claude-cli / codex-cli providers — path to the CLI binary if not on PATH
CLAUDE_CLI_PATH=claude
CODEX_CLI_PATH=codex

# ─── Optional integrations ───────────────────────────────────────────────────

# ML glucose-prediction microservice. Falls back to a physiological model when unset.
CLEARSUGAR_PREDICT_URL=
CLEARSUGAR_PREDICT_TOKEN=

# tconnectsync "Sync now" webhook (see scripts/tconnect-webhook.py).
TCONNECT_WEBHOOK_URL=
TCONNECT_WEBHOOK_TOKEN=

# iOS companion app JWT signing secret. Generate with: openssl rand -base64 32
MOBILE_JWT_SECRET=changeme

# Apple Push Notification service (iOS companion app Live Activities only).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_B64=
APNS_BUNDLE_ID=
APNS_SANDBOX=true

# Set to "true" to serve deterministic synthetic CGM/pump data instead of
# Nightscout — useful for trying the app or taking screenshots without
# real patient data.
DEMO_MODE=false

# ─── Remote access (optional) ────────────────────────────────────────────────

# Public/base URL of this app, used for QR pairing (mobile companion app) and
# links. Leave unset for LAN-only use. If using Tailscale Serve, set this to
# your https://<machine>.<tailnet>.ts.net hostname. If using a reverse proxy
# with your own domain, set this to that https://your-domain.
APP_URL=
